<Window x:Class="Zagrody.App.Views.FenceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Zagrody.App.ViewModels"
        Title="{Binding Title}"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        MinWidth="140"
        MinHeight="32"
        FontFamily="Segoe UI"
        FontSize="12"
        AllowDrop="True"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}" />
    </Window.Resources>

    <Border x:Name="Root"
            CornerRadius="6"
            Background="{Binding BackgroundBrush}"
            BorderBrush="#30FFFFFF"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title bar: drag to move, double-click to roll up, right-click for the menu. -->
            <Grid x:Name="TitleBar"
                  Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                  MouseRightButtonUp="TitleBar_MouseRightButtonUp">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="4" Height="14" CornerRadius="2" Margin="10,0,8,0" Background="{Binding AccentBrush}" />

                <TextBlock Grid.Column="1"
                           Text="{Binding Title}"
                           Foreground="White"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Visibility="{Binding IsRenaming, Converter={StaticResource InverseBoolToVisibility}}" />

                <TextBox x:Name="RenameBox"
                         Grid.Column="1"
                         Margin="0,4"
                         FontSize="13"
                         Style="{StaticResource GlassTextBox}"
                         Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibility}}"
                         KeyDown="RenameBox_KeyDown"
                         LostKeyboardFocus="RenameBox_LostKeyboardFocus" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="4,0,6,0">
                    <!-- Always visible while locked, so the state is obvious; click to unlock. -->
                    <Button Style="{StaticResource GlyphButton}" Content="&#xE72E;" Foreground="#CCFFFFFF"
                            ToolTip="Zablokowana — kliknij, aby odblokować" Click="LockButton_Click"
                            Visibility="{Binding IsLocked, Converter={StaticResource BoolToVisibility}}" />
                    <StackPanel x:Name="TitleButtons" Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Opacity" Value="0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=Root}" Value="True">
                                        <Setter Property="Opacity" Value="1" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Button Style="{StaticResource GlyphButton}" Content="&#xE721;" ToolTip="Szukaj (Ctrl+F)" Click="SearchButton_Click" />
                        <Button Style="{StaticResource GlyphButton}" Content="&#xE785;" ToolTip="Zablokuj położenie, rozmiar i ustawienia" Click="LockButton_Click"
                                Visibility="{Binding IsLocked, Converter={StaticResource InverseBoolToVisibility}}" />
                        <Button x:Name="RollButton" Style="{StaticResource GlyphButton}" Content="&#xE70E;" ToolTip="Zwiń / rozwiń" Click="RollButton_Click" />
                        <Button Style="{StaticResource GlyphButton}" Content="&#xE712;" ToolTip="Menu" Click="MenuButton_Click" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Hairline between the title and the content. -->
            <Border x:Name="TitleSeparator"
                    Height="1"
                    Margin="10,0"
                    VerticalAlignment="Bottom"
                    Background="#2EFFFFFF"
                    IsHitTestVisible="False" />

            <TextBox x:Name="SearchBox"
                     Grid.Row="1"
                     Margin="8,0,8,6"
                     Style="{StaticResource GlassTextBox}"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Visibility="Collapsed"
                     PreviewKeyDown="SearchBox_PreviewKeyDown" />

            <Grid x:Name="ContentArea" Grid.Row="2">
                <ListBox x:Name="ItemsList"
                         ItemsSource="{Binding View}"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="White"
                         Padding="4,0,2,6"
                         SelectionMode="Extended"
                         ItemContainerStyle="{StaticResource FenceItemContainer}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         PreviewMouseLeftButtonDown="ItemsList_PreviewMouseLeftButtonDown"
                         PreviewMouseLeftButtonUp="ItemsList_PreviewMouseLeftButtonUp"
                         PreviewMouseMove="ItemsList_PreviewMouseMove"
                         PreviewMouseRightButtonUp="ItemsList_PreviewMouseRightButtonUp"
                         MouseDoubleClick="ItemsList_MouseDoubleClick"
                         KeyDown="ItemsList_KeyDown">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ItemViewModel}">
                            <StackPanel x:Name="Tile"
                                        Margin="2,5,2,4"
                                        Width="{Binding DataContext.TileWidth, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        ToolTip="{Binding ToolTip}">
                                <Image Source="{Binding Icon}"
                                       Width="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                       Height="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Text="{Binding DisplayName}"
                                           Margin="2,4,2,0"
                                           Foreground="White"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"
                                           MaxHeight="32">
                                    <TextBlock.Effect>
                                        <DropShadowEffect ShadowDepth="1" BlurRadius="3" Opacity="0.85" Color="Black" />
                                    </TextBlock.Effect>
                                </TextBlock>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                    <Setter TargetName="Tile" Property="Opacity" Value="0.4" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="{Binding EmptyText}"
                           Foreground="#AAFFFFFF"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="16"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
            </Grid>

            <!-- Highlight while something is dragged over the fence. -->
            <Border Grid.RowSpan="3"
                    CornerRadius="6"
                    BorderThickness="2"
                    BorderBrush="{Binding AccentBrush}"
                    IsHitTestVisible="False"
                    Visibility="{Binding IsDropTarget, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
    </Border>
</Window>
