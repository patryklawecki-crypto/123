<Window x:Class="Zagrody.App.Views.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zagrody — szukaj"
        Width="600"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}" />
    </Window.Resources>

    <Border Margin="18" CornerRadius="10" Background="#F21C1E24" BorderBrush="#40FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5" />
        </Border.Effect>
        <StackPanel Margin="10">
            <Grid>
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="#99FFFFFF"
                           VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False" />
                <TextBox x:Name="QueryBox"
                         FontSize="18"
                         Padding="34,6,8,6"
                         Style="{StaticResource GlassTextBox}"
                         Background="Transparent"
                         BorderThickness="0"
                         TextChanged="QueryBox_TextChanged"
                         PreviewKeyDown="QueryBox_PreviewKeyDown" />
                <TextBlock x:Name="Placeholder" Text="Szukaj we wszystkich zagrodach…" FontSize="18" Foreground="#66FFFFFF"
                           VerticalAlignment="Center" Margin="42,0,0,0" IsHitTestVisible="False" />
            </Grid>

            <ListBox x:Name="Results"
                     Margin="0,8,0,0"
                     MaxHeight="420"
                     Background="Transparent"
                     BorderThickness="0"
                     ItemContainerStyle="{StaticResource ResultItemContainer}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="Results_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image Source="{Binding Item.Icon}" Width="32" Height="32" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Item.DisplayName}" Foreground="White" FontSize="14" TextTrimming="CharacterEllipsis" />
                                <TextBlock Foreground="#88FFFFFF" FontSize="11" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding Fence.Title, Mode=OneWay}" Foreground="{Binding Fence.AccentBrush, Mode=OneWay}" />
                                    <Run Text=" · " />
                                    <Run Text="{Binding Item.Path, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="EmptyHint" Text="Brak wyników" Foreground="#88FFFFFF" Margin="10,10,0,4" Visibility="Collapsed" />

            <TextBlock Margin="8,10,8,2" Foreground="#66FFFFFF" FontSize="11" TextWrapping="Wrap"
                       Text="Enter — otwórz · Ctrl+Enter — pokaż w Eksploratorze · Alt+Enter — pokaż w zagrodzie · Esc — zamknij" />
        </StackPanel>
    </Border>
</Window>
